<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permission to query RAG backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Audio recording for Speech-to-Text -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- START MODIFICATION: Background wake FGS (#14) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- END MODIFICATION -->

    <!-- Car API permissions (Pre-granted on simulated Skycraft system runtime) -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="android.car.permission.CAR_DRIVING_STATE" />
    <uses-permission android:name="android.car.permission.CAR_UX_RESTRICTIONS_CHANGE" />

    <!-- MODIFIED: cross-app MediaSession control (requires priv-app whitelist) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- MODIFIED: discover / launch music apps for multi-session control -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.soundcloud.android" />
    </queries>

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Wheelchair Copilot"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <meta-data android:name="distractionOptimized" android:value="true" />

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name="com.wheelchair.cockpit.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                
                <!-- Display on standard launcher -->
                <category android:name="android.intent.category.LAUNCHER" />
                
                <!-- Display on AAOS Digital Cockpit App Grid launcher -->
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- START MODIFICATION: Microphone FGS for Hey Car standby -->
        <service
            android:name=".voice.WakeWordForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- END MODIFICATION -->

        <!-- MODIFIED: local MP3 MediaSession so demo always has a controllable source -->
        <service
            android:name=".media.LocalMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- MODIFIED: Studio path for YT Music / SoundCloud sessions without priv-app remount -->
        <service
            android:name=".media.MediaNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
